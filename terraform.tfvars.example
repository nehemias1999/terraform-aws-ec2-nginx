# Copy to terraform.tfvars and adjust. terraform.tfvars is NOT committed.

aws_region          = "region-name"
aws_profile         = "profile-name"
owner               = "email-or-name"
team                = "team-name"
environment         = "environment-name"
project             = "project-name"
instance_type       = "instance-type-name"
ssh_public_key_path = "public-key-file-name"
allowed_ssh_cidr    = "YOUR_PUBLIC_IP/32" # curl https://checkip.amazonaws.com 
allowed_http_cidr   = "0.0.0.0/0"
