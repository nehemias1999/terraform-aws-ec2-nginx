# Local directory with downloaded providers and modules (created by terraform init)
**/.terraform/*

# State: contains IDs, IPs and sometimes plain-text secrets
*.tfstate
*.tfstate.*

# Crash logs: contain sensitive debugging information
crash.log
crash.*.log

# Variable files with real values (passwords, API keys, etc.)
*.tfvars
*.tfvars.json

# Override files that may contain sensitive values
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Saved plans: may contain sensitive values
*.tfplan
tfplan

# Local plan/apply logs (contain account IDs, IPs, etc.)
*.log

# Sensitive Terraform Cloud/Enterprise CLI config
.terraformrc
terraform.rc

# SSH private keys: NEVER commit them (the .pub file is fine)
*.key
*.pem
id_rsa
id_ed25519
